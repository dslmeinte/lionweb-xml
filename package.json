{
    "name": "lionweb-xml",
    "version": "0.0.0-dev",
    "description": "Tooling around LionWeb and XML",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LionWeb-io/lionweb-xml.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-xml/issues"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "9.39.2",
        "@typescript-eslint/eslint-plugin": "8.51.0",
        "@typescript-eslint/parser": "8.51.0",
        "rimraf": "6.1.2",
        "typescript": "5.9.3"
    },
    "scripts": {
        "clean": "npm run clean -w packages --if-present && npx rimraf node_modules",
        "setup": "npm run setup -w packages --if-present",
        "initialize": "npm run clean && npm install && npm run setup",
        "build": "npm run build -w packages --if-present",
        "test": "npm run test -w packages --if-present",
        "lint": "npm run lint -w packages --if-present"
    },
    "private": true,
    "workspaces": [
        "./packages/build",
        "./packages/lionweb-ecore",
        "./packages/examples"
    ]
}
