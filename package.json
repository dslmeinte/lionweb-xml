{
    "name": "lionweb-emf",
    "version": "0.0.0-dev",
    "description": "Interoperability with the Eclipse Modeling Framework (EMF)",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LionWeb-io/lionweb-ecore.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-ecore/issues"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.1",
        "@eslint/js": "9.39.1",
        "@types/node": "24.10.0",
        "@typescript-eslint/eslint-plugin": "8.46.4",
        "@typescript-eslint/parser": "8.46.4",
        "rimraf": "6.1.0",
        "typescript": "5.9.3"
    },
    "scripts": {
        "clean": "npm run clean -w packages --if-present && npx rimraf node_modules",
        "setup": "npm run setup -w packages --if-present",
        "initialize": "npm run clean && npm install && npm run setup",
        "build": "npm run build -w packages --if-present",
        "test": "npm run test -w packages --if-present",
        "lint": "npm run lint -w packages --if-present"
    },
    "private": true,
    "workspaces": [
    ]
